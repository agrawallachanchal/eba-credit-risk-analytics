model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["banks", "countries", "bank_exposure", "sector", "country_asset_quality", "npe_trend", "stress_results"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table banks
ref table countries
ref table bank_exposure
ref table sector
ref table country_asset_quality
ref table npe_trend
ref table stress_results
