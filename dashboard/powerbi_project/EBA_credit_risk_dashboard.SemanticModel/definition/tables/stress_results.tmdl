	partition stress_results = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("__DATA_FOLDER__stress_results.csv"), [Delimiter = ",", Columns = 12, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"lei_code", type text}, {"bank", type text}, {"role", type text}, {"scenario_code", type text}, {"scenario", type text}, {"view", type text}, {"cet1_ratio_today", type number}, {"cet1_requirement", type number}, {"headroom_today", type number}, {"stressed_cet1_ratio", type number}, {"headroom", type number}, {"below_requirement", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
