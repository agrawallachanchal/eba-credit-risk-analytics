table stress_results
	lineageTag: 6df530fe-bf2a-a9ac-6505-f5107e466386

	measure 'Headroom After Shock' = SUM ( stress_results[headroom] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 245e3467-a9ad-f49f-ae42-1569adaf8cc7

	measure 'Headroom Today' = MAX ( stress_results[headroom_today] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 796d23ea-ee48-757a-8093-d45b17902e91

	measure 'Stressed CET1 Ratio' = SUM ( stress_results[stressed_cet1_ratio] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 255aa0ce-f323-f6ee-6386-04b5631e6e43

	measure 'Core Banks Below Requirement' =
			CALCULATE (
			DISTINCTCOUNT ( stress_results[lei_code] ),
			stress_results[role] = "Core",
			stress_results[below_requirement] = "Yes"
			) + 0
		formatString: 0
		lineageTag: 0d730d6e-7ee5-ac0a-6c5a-3c2897074bf3

	measure 'Median Headroom Core' = CALCULATE ( MEDIAN ( stress_results[headroom] ), stress_results[role] = "Core" )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6da3fd23-9bd1-2854-c9ef-2b2737fe15a7

	measure 'Median Headroom Today Core' =
			CALCULATE (
			MEDIAN ( stress_results[headroom_today] ),
			stress_results[role] = "Core",
			stress_results[view] = "Instant loss"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3759b1fe-ac74-e79b-8cd5-1e87f460d1be

	measure 'Headroom Colour' = IF ( [Headroom After Shock] < 0, "#B42318", IF ( [Headroom After Shock] < 0.01, "#D97706", "#1F3A4D" ) )
		lineageTag: 903d8150-de19-23e0-d1fe-76784e472c95

